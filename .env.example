# Server Configuration
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration
# Local zero-friction SQLite default (works immediately without any external services):
DATABASE_URL="file:../../prisma/dev.db"
# Or PostgreSQL for Docker/Production:
# DATABASE_URL="postgresql://chess_user:chess_secret@localhost:5432/chess_db?schema=public"

# Redis Configuration (Optional: in-memory store used automatically when Redis is offline)
REDIS_URL="redis://localhost:6379"

# Security & Authentication
JWT_SECRET=neochess_ultra_secure_jwt_secret_dev_2025_long_key_xyz
JWT_EXPIRES_IN=7d

# Engine Worker
WORKER_CONCURRENCY=2
MAX_STOCKFISH_DEPTH=15

# Google OAuth 2.0 / OpenID Connect (100% Free - $0)
# Instructions to get credentials:
# 1. Open Google Cloud Console: https://console.cloud.google.com/
# 2. Go to APIs & Services -> Credentials -> Create Credentials -> OAuth Client ID
# 3. Application Type: "Web application"
# 4. Authorized JavaScript origins:
#    - http://localhost:5173
#    - http://localhost:3001
#    - (Add your production domain or Cloudflare tunnel URL if deployed)
# 5. Authorized redirect URIs:
#    - http://localhost:5173/auth/callback
#    - http://localhost:3001/api/auth/google/callback
# 6. Copy Client ID and Client Secret below:
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Public Deployment Configuration (Optional)
# Set when deploying publicly via Cloudflare Tunnel, Render, or VPS
# PUBLIC_SERVER_URL="https://your-server-domain.com"
# PUBLIC_CLIENT_URL="https://your-web-domain.com"
